            "name": "commoninit_podman_v2.iso",
            "network_config": "version: 2\nethernets:\n  ens3:\n    dhcp4: false\n    addresses:\n      - 10.0.0.20/24\n    routes:\n      - to: default\n        via: 10.0.0.254\n    nameservers:\n      addresses: [9.9.9.9, 1.1.1.2]\n",
            "pool": "default",
            "user_data": "#cloud-config\n\n# 1. Configuración del usuario administrador\nusers:\n  - name: walter\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    groups: users, admin\n    shell: /bin/bash\n    lock_passwd: false\n    passwd: \"$6$fiQHuPJPs.Dfdz05$2lnqVHsjzNMm9MJCkAdMX3h.cgIZRLFpCQ1Ef6KG8cEsgs2fdlX8D.YG//j5TAz4mxEWVS258dYs5uW4SoV401\"\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP1Zj4Zj9BfTzob0mAGz14KuNtOV9mVpcyrPQWuzhaOz walter@thinkpad-lab\n\n# 3. Configuración SSH\nssh_pwauth: false\n\n# 4. Actualización automática al nacer\npackage_update: true\npackage_upgrade: true\n\n# 5. Hostname personalizado al nombre de la MV:\n\nhostname: podman-node\nfqdn: podman-node.secdevops.local\nmanage_etc_hosts: true\n"
          },
